{
  "name": "railway-intelligence-system",
  "version": "1.0.0",
  "private": true,
  "description": "Railway Intelligence System - AI-driven train delay prediction and tracking",
  "scripts": {
    "dev": "concurrently -n \"client,server\" -c \"cyan.bold,magenta.bold\" \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "python -m uvicorn app.main:app --reload --app-dir server --port 8000",
    "build": "npm run build --prefix client",
    "build:client": "npm run build --prefix client",
    "install:client": "npm install --prefix client",
    "install:server": "pip install -r server/requirements.txt",
    "install:all": "npm run install:client && npm run install:server",
    "lint": "npm run lint --prefix client",
    "test:server": "pytest server/tests"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
